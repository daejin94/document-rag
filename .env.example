OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# 이 이메일로 가입한 계정은 서버 시작 시 SUPER_ADMIN(관리자 페이지 접근)으로 자동 승격됩니다.
SUPER_ADMIN_EMAIL=

# 구글 OAuth 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID)
# 아래 두 변수를 채우면 구글 로그인이 활성화되고, 비워두면(주석 처리하면) 이메일/비밀번호 로그인만 동작합니다.
# 변수명은 Spring 표준 바인딩 이름입니다. registration 키가 application.yml에 있으면 빈 값에도 부팅이
# 실패하므로, 설정은 반드시 이 환경변수로만 주입합니다.
# 승인된 리디렉션 URI에 아래 ...GOOGLE_REDIRECT_URI 값을 Google Cloud Console에 그대로 등록해야 합니다.
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google
# OAuth 로그인 완료 후 돌아갈 프론트엔드 주소
OAUTH_FRONTEND_URL=http://localhost:5173/

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<SUPABASE_DB_PASSWORD>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# Local Docker Postgres host port override
# POSTGRES_HOST_PORT=15432
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/rag_db

# Supabase Postgres direct connection
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<SUPABASE_DB_PASSWORD>

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=document-rag-bucket

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20
